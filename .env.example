# ─────────────────────────────────────────────────────────────────────────────
#  Ebi Sushi — variables d'environnement
#  Copier ce fichier en « .env.local » et renseigner les valeurs réelles.
#  Aucune variable n'est obligatoire pour faire tourner le site en local :
#  des valeurs de repli sont définies dans src/config/.
# ─────────────────────────────────────────────────────────────────────────────

# Domaine public définitif du site, sans barre oblique finale.
# Sert aux URL canoniques, au sitemap, aux balises Open Graph et aux
# données structurées. À renseigner impérativement avant la mise en ligne.
NEXT_PUBLIC_SITE_URL=https://ebisushi.ma

# Numéro WhatsApp qui reçoit les commandes et les demandes de réservation.
# Format international, sans « + » ni espaces (ex. 212612345678).
# Sans cette variable, le site utilise la valeur de src/config/business.ts,
# qui provient d'un annuaire public et DOIT être confirmée par le restaurant.
NEXT_PUBLIC_WHATSAPP_NUMBER=212664999693

# Clé fal.ai — uniquement nécessaire pour régénérer les visuels d'ambiance
# via « npm run images ». Inutile pour faire tourner ou déployer le site.
FAL_KEY=
